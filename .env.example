# Prefer npm run setup to generate .env with random local credentials.
POSTGRES_USER=workflow
POSTGRES_PASSWORD=replace_with_a_random_url_safe_password
POSTGRES_DB=workflow_engine
DATABASE_URL=postgresql://workflow:replace_with_a_random_url_safe_password@127.0.0.1:5433/workflow_engine
API_KEY=replace_with_at_least_32_random_url_safe_characters
API_PORT=3000
